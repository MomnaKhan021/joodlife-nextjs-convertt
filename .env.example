# PostgreSQL connection string
# Local:    postgres://postgres:postgres@127.0.0.1:5432/joodlife
# Vercel Postgres / Neon / Supabase: paste the pooled connection string here
DATABASE_URI=postgres://postgres:postgres@127.0.0.1:5432/joodlife

# Payload secret (generate with: openssl rand -base64 32)
PAYLOAD_SECRET=replace-with-a-long-random-string

# Public URL for the site (used for CORS / media URLs)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Optional: seed script admin credentials (used by `npm run seed`)
SEED_ADMIN_EMAIL=admin@joodlife.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# ────────────  Email / SMTP (transactional mail)  ────────────
# Account-creation ("welcome"), password-reset, etc. WITHOUT these, Payload
# falls back to a console adapter that only LOGS mail and sends nothing — so
# no account emails will arrive. Fill these in to actually deliver mail.
#   e.g. SendGrid: host=smtp.sendgrid.net port=587 user=apikey pass=<API_KEY>
#   e.g. Resend:   host=smtp.resend.com   port=465 user=resend pass=<API_KEY>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM_ADDRESS=no-reply@joodlife.com
EMAIL_FROM_NAME=JoodLife

# ────────────  Brevo (marketing stats for the analytics dashboard)  ────────────
# Sending email uses the SMTP creds above. Reading campaign stats (email
# open/click rate, SMS delivery) needs Brevo's REST API v3 key — a DIFFERENT
# credential. Create one at Brevo → SMTP & API → API Keys, then paste it here.
# Without it the dashboard's marketing tiles show "Connect Brevo".
# (Tip: if your SMTP_PASS is already a v3 key — starts with "xkeysib-" — it's
#  reused automatically; a Brevo "SMTP key" starting "xsmtpsib-" will NOT work.)
BREVO_API_KEY=

# ────────────  Trustpilot (review count/rating on the dashboard)  ────────────
# Trustpilot blocks ALL server-side reads (review page + API both 403 to
# servers, and the REST API needs a PAID plan). The free, sanctioned way to
# show a live rating + review count is Trustpilot's client-side TrustBox
# widget. Set your Business Unit ID below and the Analytics "Trustpilot
# reviews" tile renders the live widget; leave it blank and the tile is still
# a link to your public review page.
#
# Find the Business Unit ID (free): Trustpilot Business → get a TrustBox
# widget → the embed snippet contains data-businessunit-id="…". Paste that ID.
# These are PUBLIC values (they ship to the browser), so the NEXT_PUBLIC_ prefix
# is intentional and safe.
NEXT_PUBLIC_TRUSTPILOT_BUSINESS_UNIT_ID=
NEXT_PUBLIC_TRUSTPILOT_DOMAIN=joodlife.com

# Optional: only if you have a PAID Trustpilot API plan (server-side rating).
TRUSTPILOT_API_KEY=
TRUSTPILOT_DOMAIN=joodlife.com

# ────────────  Stripe (payments)  ────────────
# Server-side secret (sk_test_… in dev, sk_live_… in prod). NEVER expose
# this in the browser bundle.
STRIPE_SECRET_KEY=

# Public publishable key (pk_test_… / pk_live_…). Safe to send to the
# client; only used for redirect flows + future Elements integration.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Webhook signing secret. Generate per-endpoint in the Stripe dashboard
# → Developers → Webhooks. Used by /api/stripe/webhook to verify
# event authenticity. Without this, the webhook rejects everything.
STRIPE_WEBHOOK_SECRET=

# ────────────  Checkout policy  ────────────
# Set to "true" to require an authenticated Payload user before
# /api/checkout will create an order. Anonymous (guest) checkout is
# enabled by default.
JOOD_REQUIRE_AUTH_FOR_CHECKOUT=false

# ────────────  DPD Local (dispatch labels)  ────────────
# Required for generating shipping labels via the DPD Local REST API.
# During the testing phase, use your MyDPD Local web login (my.dpdlocal.co.uk).
DPD_API_USER=                    # Your MyDPD Local username
DPD_API_PASS=                    # Your MyDPD Local password
DPD_ACCOUNT_NO=                  # DPD Local account number (e.g. 3029267)

# API host — DPD Local; use https://api.dpd.co.uk for a standard DPD account
DPD_API_BASE=https://api.dpdlocal.co.uk

# Sender / collection address (your pharmacy / dispatch address)
DPD_SENDER_NAME=Jood Life
DPD_SENDER_STREET=1 Sender Street
DPD_SENDER_TOWN=London
DPD_SENDER_POSTCODE=EC1A 1BB

# DPD service network code (default: 1^12 = Next Day Parcel)
# See DPD network codes documentation for other options (e.g. Saturday, International)
DPD_NETWORK_CODE=1^12

# Default parcel weight in kg
DPD_PARCEL_WEIGHT_KG=0.5
