{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/hubspot/sync-all",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/abandoned-reminders",
      "schedule": "0 9 * * *"
    }
  ],
  "functions": {
    "app/api/hubspot/sync-all/route.ts": { "maxDuration": 60 },
    "app/api/cron/abandoned-reminders/route.ts": { "maxDuration": 60 }
  }
}
