{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/hubspot/sync-all",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/abandoned-reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/cron/assessment-reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/assessment-nudge",
      "schedule": "0 10 * * *"
    }
  ],
  "functions": {
    "app/api/hubspot/sync-all/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/abandoned-reminders/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/assessment-reminders/route.ts": {
      "maxDuration": 60
    },
    "app/api/cron/assessment-nudge/route.ts": {
      "maxDuration": 60
    }
  }
}
